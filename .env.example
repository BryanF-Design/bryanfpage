PORT=3001
SITE_URL=https://www.bryanfdesign.com
NEXT_PUBLIC_SITE_URL=https://www.bryanfdesign.com
NEXT_PUBLIC_GA_ID=G-4GLGP6X573

# Google Ads (opcional; ver GOOGLE_ADS_SETUP.md). Con sólo el ID se activan
# remarketing y atribución; cada etiqueta habilita esa conversión en Ads.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=
WHATSAPP_NUMBER=525663012505

# SEO / Analytics
GA4_PROPERTY_ID=504755650
GSC_SITE_URL=sc-domain:bryanfdesign.com
GOOGLE_AUTH_MODE=oauth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Service account fallback. Currently not used because org policy blocks JSON key creation.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
SEO_REPORT_EMAIL=bryanf@bryanfdesign.com
ANTHROPIC_API_KEY=

# Stripe
STRIPE_PUBLIC=pk_live_xxx
STRIPE_SECRET=sk_live_xxx
# Firma del webhook (Stripe Dashboard → Developers → Webhooks → endpoint
# /api/stripe-webhook, evento checkout.session.completed). Sin esto el webhook
# responde 500 a propósito para que Stripe reintente cuando esté configurado.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Suscripción mensual (opcional): precio recurrente creado en Stripe. Sin él,
# el precio se arma desde lib/catalog.ts (SUBSCRIPTION_PLAN).
STRIPE_SUBSCRIPTION_PRICE_ID=
# Portal de clientes de Stripe (Settings → Billing → Customer portal → enlace
# de inicio de sesión): el suscriptor administra o cancela ahí.
NEXT_PUBLIC_STRIPE_PORTAL_URL=

# Mercado Pago
MP_PUBLIC_KEY=APP_USR-xxxx
MP_ACCESS_TOKEN=APP_USR-xxxx
MP_CLIENT_ID=xxxxxxxxxxxx
MP_CLIENT_SECRET=xxxxxxxxxxxx
# Opcional: clave secreta del webhook (MP → Tus integraciones → Webhooks) para
# verificar la firma x-signature. Si se omite, la autenticidad se garantiza
# re-consultando el pago con MP_ACCESS_TOKEN.
MP_WEBHOOK_SECRET=
# Plan de suscripción de Mercado Pago (opcional). Si falta, el sitio busca o
# crea una sola vez el plan "BryanF Design · Suscripción Todo Digital".
MP_SUBSCRIPTION_PLAN_ID=

# Conversión MXN⇄USD del configurador (referencia comercial redondeada).
# NEXT_PUBLIC_* la usa el navegador para mostrar precios; USD_MXN_RATE la usa
# el servidor si Mercado Pago rechaza USD y hay que cobrar el equivalente MXN.
NEXT_PUBLIC_USD_MXN_RATE=18
USD_MXN_RATE=18

# OpenAI (backend only)
OPENAI_API_KEY=sk-proj-xxxx
# Opcional: modelo de Lumina (por defecto gpt-4.1-mini; si no existe cae a gpt-4o-mini)
OPENAI_MODEL=

# Correo transaccional por Google (Gmail API). Ver CORREOS_SETUP.md.
# Comprobantes, mensualidades, recordatorios, brief recibido y avisos internos.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Refresh token con permiso gmail.send: node scripts/google-refresh-token.mjs
GOOGLE_REFRESH_TOKEN=
# Cuenta que envía (o un alias "Enviar como" verificado en esa cuenta).
GOOGLE_SENDER_EMAIL=bryanf@bryanfdesign.com
# A dónde llegan los avisos internos (ventas, cobros, briefs).
GOOGLE_NOTIFICATION_EMAIL=bryanf@bryanfdesign.com

# Respaldo opcional: si Google falla o no está configurado, se usa Resend.
RESEND_API_KEY=
MAIL_FROM=BryanF Design <no-reply@tu-dominio.com>

# Mi panel: con la base de datos configurada, los correos enlazan
# www.bryanfdesign.com/mi-panel. Solo llénalo para mandar a otra dirección.
CLIENT_PORTAL_URL=

# Base de datos del sitio (Supabase, proyecto BryanF-Access, esquema `sitio`):
# cuentas de clientes, contraseñas, compras, temporadas, descuentos y avisos.
# La llave del servidor se compara contra su hash en sitio.llave.
SUPABASE_URL=https://gomboknokiefchfjxljw.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SITIO_DB_KEY=
# Opcional: firma de la sesión de Mi panel (si falta usa ADMIN_SESSION_SECRET).
CLIENT_SESSION_SECRET=

# Firma de los enlaces a "Armar mi brief" de pagos confirmados a mano.
# Cualquier texto largo y aleatorio (openssl rand -hex 32).
BRIEF_LINK_SECRET=
# Llave de /api/admin/* (cobros con link, confirmar transferencias, pruebas).
# Mínimo 24 caracteres (openssl rand -hex 24).
ADMIN_API_KEY=
# Panel BryanF (/admin): panel privado de suscriptores. Usuario y contraseña
# del administrador; sin ADMIN_PASSWORD (mínimo 12 caracteres) está apagado.
# Cambiar la contraseña cierra todas las sesiones abiertas.
ADMIN_USER=bryanf
ADMIN_PASSWORD=
# Opcional: secreto extra para firmar la sesión (openssl rand -hex 32).
ADMIN_SESSION_SECRET=
# Vercel Cron: recordatorio diario de mensualidad de Mercado Pago.
CRON_SECRET=
# Días de anticipación del recordatorio (Mercado Pago). Stripe usa su propio ajuste.
REMINDER_DAYS=3
